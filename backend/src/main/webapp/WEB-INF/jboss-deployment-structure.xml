<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot trae su propio logging, JPA (Hibernate), validación y capa web.
  Se excluyen los subsistemas equivalentes de JBoss/WildFly para evitar conflictos de clases.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>
        <exclude-subsystems>
            <subsystem name="logging"/>
            <subsystem name="jaxrs"/>
            <subsystem name="jpa"/>
            <subsystem name="weld"/>
            <!-- Jakarta Faces necesita CDI (weld) al arrancar; sin esta exclusión el despliegue
                 falla con "CDI is not available". VeriPay no usa JSF: el frontend es Angular. -->
            <subsystem name="jsf"/>
        </exclude-subsystems>
        <exclusions>
            <module name="org.slf4j"/>
            <module name="org.slf4j.impl"/>
            <module name="org.jboss.logging"/>
        </exclusions>
    </deployment>
</jboss-deployment-structure>
